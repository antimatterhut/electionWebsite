{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4190 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4190/",
        "http://localhost:4190/state/GA",
        "http://localhost:4190/methodology",
        "http://localhost:4190/about"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "onlyCategories": [
          "performance",
          "accessibility",
          "seo",
          "best-practices"
        ],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 122880
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}