{
  "name": "senate-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node scripts/prepare_data.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:mock": "node scripts/make_mock_data.mjs",
    "data:topo": "node scripts/build_topo.mjs",
    "og": "node scripts/make_og.mjs",
    "cb": "node scripts/check_cb.mjs",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "test:all": "npm run check && npm test && npm run build && npm run cb && npm run size && npm run test:e2e",
    "pretest": "node scripts/prepare_data.mjs --no-og",
    "pretest:e2e": "npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/inter": "^5.3.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@size-limit/file": "^14.3.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/d3-delaunay": "^6.0.4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "satori": "^0.63.2",
    "size-limit": "^14.3.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^6.0.3",
    "us-atlas": "^3.0.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.5",
    "d3-geo": "^3.1.2",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "marked": "^18.1.3",
    "topojson-client": "^3.1.0"
  }
}